{
  "name": "liemax",
  "version": "1.2.0",
  "description": "Cinema screen comparison engine",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false",
    "validate": "ts-node --transpile-only src/math/validate.ts",
    "validate:compare": "ts-node --transpile-only src/compare/validate.ts",
    "validate:dolby": "ts-node --transpile-only src/data/validateDolbyCinemaCount.ts",
    "dolby:check": "ts-node --transpile-only src/data/dolbyCinemaCount.ts",
    "build:docs-data": "ts-node --transpile-only src/docs/buildDocsData.ts",
    "check:docs-data": "ts-node --transpile-only src/docs/buildDocsData.ts --check",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "validate:web": "npm run check:docs-data && node scripts/validate-web.mjs",
    "validate:schema": "ts-node --transpile-only src/data/validate.ts",
    "test": "npm run validate && npm run validate:compare",
    "ci": "npm run typecheck && npm run typecheck:web && npm run validate && npm run validate:schema && npm run validate:compare && npm run validate:dolby && npm run build:web && npm run validate:web"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
