{
  "name": "liemax",
  "version": "1.2.0",
  "description": "Cinema screen comparison engine",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false",
    "validate": "ts-node --transpile-only src/math/validate.ts",
    "validate:schema": "ts-node --transpile-only src/data/validate.ts",
    "test": "npm run validate",
    "ci": "npm run typecheck && npm run validate && npm run validate:schema"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "@types/node": "^20.0.0"
  }
}
