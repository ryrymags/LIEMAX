{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "paths": {
      "@math/*": ["../src/math/*"],
      "@math": ["../src/math"],
      "@data/*": ["../src/data/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../src/math/**/*"]
}
